{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AOS Mail",
  "version": "0.1.8",
  "identifier": "com.mrdulasolutions.aosmail",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AOS Mail",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "public.app-category.productivity",
    "shortDescription": "Agent-operated email — multi-inbox Mac mail with Claude in the loop.",
    "longDescription": "AOS Mail is a native Mac email client built around an agent loop. It combines Gmail/IMAP multi-account sync with the Claude agent stack to triage, draft, schedule, and archive — all inside a fast, keyboard-first inbox you actually want to use.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "../build/entitlements.mac.plist",
      "infoPlist": "../build/Info.plist",
      "signingIdentity": "Developer ID Application: Matthew Dula (PPY9K2BYJH)",
      "hardenedRuntime": true
    },
    "externalBin": ["binaries/aos-mail-sidecar", "binaries/aos-mail-node"],
    "resources": {
      "../sidecar/runtime-modules": "runtime-modules"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mrdulasolutions/AOS-Mail/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDOUYxQTFCNDgwMjVBMUEKUldRYVdnSklHeHFmck91SGRjYW0wNXpTWFFyWjYvenVwdkNnUnZvNFdmYnhXYmlKNUdNMjdGUm0K"
    }
  }
}
